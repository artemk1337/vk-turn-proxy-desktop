# syntax=docker/dockerfile:1
FROM golang:1.26-bookworm@sha256:dc40a13b61304647ed7e5d581d246b86413dfc29d63c6d018310feb93cd98fc0 AS build
RUN apt-get update && apt-get install -y --no-install-recommends unzip zip ca-certificates curl nsis && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY go.mod go.sum ./
COPY third_party ./third_party
RUN go mod download && go install github.com/akavel/rsrc@v0.10.2
COPY . .
ARG RUN_TESTS=true
RUN if [ "$RUN_TESTS" = true ]; then go test -count=1 ./tools/vk-turn-proxy-console ./tools/vk-turn-proxy-windows ./pkg/vk-auth ./pkg/wireguard-profile ./pkg/proxy/srtpwrap ./pkg/turnbind; fi
ARG VERSION=v1.2.1
RUN set -eu; mkdir -p /out; for arch in amd64 arm64; do \
      dir="/out/vk-turn-proxy-windows-${VERSION}-${arch}"; mkdir -p "$dir"; \
      rsrc -arch "$arch" -manifest tools/vk-turn-proxy-windows/app.manifest -o "tools/vk-turn-proxy-windows/rsrc_windows_${arch}.syso"; \
      GOOS=windows GOARCH="$arch" CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -H=windowsgui" -o "$dir/vk-turn-proxy-windows.exe" ./tools/vk-turn-proxy-windows; \
      rsrc -arch "$arch" -manifest tools/vk-turn-proxy-windows/app.manifest -o "tools/vk-turn-proxy-console/rsrc_windows_${arch}.syso"; \
      GOOS=windows GOARCH="$arch" CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" -o "$dir/vk-turn-proxy-console.exe" ./tools/vk-turn-proxy-console; \
      cp README.md README.ru.md LICENSE NOTICE.md "$dir/"; \
      cp third_party/walk/LICENSE "$dir/WALK-LICENSE.txt"; \
      cat "$(go env GOPATH)/pkg/mod/github.com/wailsapp/go-webview2@v1.0.23/LICENSE" "$(go env GOPATH)/pkg/mod/github.com/wailsapp/go-webview2@v1.0.23/webviewloader/LICENSE" > "$dir/WEBVIEW2-LICENSE.txt"; \
    done
RUN mkdir /tmp/wintun-parts && seq 0 91 | xargs -P 8 -I '{}' sh -c \
    'start=$(({} * 8192)); end=$((start + 8191)); [ "$end" -lt 750540 ] || end=750539; \
     curl -fsSL --retry 3 --connect-timeout 15 --max-time 30 --range "$start-$end" \
       https://www.wintun.net/builds/wintun-0.14.1.zip -o "/tmp/wintun-parts/$(printf "%03d" {}).part"' \
    && cat /tmp/wintun-parts/*.part > /tmp/wintun.zip
# The official driver archive is pinned by its digest below.
RUN echo '07c256185d6ee3652e09fa55c0b673e2624b565e02c4b9091c79ca7d2f24ef51  /tmp/wintun.zip' | sha256sum -c - && unzip -q /tmp/wintun.zip -d /tmp/wintun
RUN set -eu; for arch in amd64 arm64; do \
      dir="/out/vk-turn-proxy-windows-${VERSION}-${arch}"; \
      cp "/tmp/wintun/wintun/bin/$arch/wintun.dll" "$dir/"; \
      cp /tmp/wintun/wintun/LICENSE.txt "$dir/WINTUN-LICENSE.txt"; \
      makensis -WX -DVERSION="${VERSION#v}" -DARCH="$arch" -DINPUT_DIR="$dir" -DOUTPUT_FILE="/out/vk-turn-proxy-windows-${VERSION}-${arch}-setup.exe" installer/windows.nsi; \
      (cd /out && zip -qr "vk-turn-proxy-windows-${VERSION}-${arch}.zip" "$(basename "$dir")"); \
      rm -rf "$dir"; \
    done && cd /out && sha256sum *.zip *-setup.exe > SHA256SUMS.txt
FROM scratch
COPY --from=build /out/ /
